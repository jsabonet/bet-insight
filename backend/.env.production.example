# ==============================================
# CONFIGURACAO DE PRODUCAO - BACKEND
# ==============================================
# Copie para backend/.env.production e preencha os valores marcados com
# "TROCAR". Este ficheiro NUNCA deve ser commitado (.gitignore).
#
#   cp backend/.env.production.example backend/.env.production
#   chmod 600 backend/.env.production
#
# DB_NAME, DB_USER e DB_PASSWORD daqui sao a FONTE DE VERDADE: o
# scripts/deploy.sh copia-os para o .env da raiz, que e o ficheiro que o
# Docker Compose le para configurar o servico `db`.

# ------------------------------------------------------------------------------
# Django (obrigatorio)
# ------------------------------------------------------------------------------
DEBUG=False

# Gerar: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=TROCAR-POR-CHAVE-GERADA-COM-SECRETS

# Tem de incluir todos os hosts pelos quais se acede. `localhost` e obrigatorio:
# e o Host usado pelo healthcheck do container (curl http://localhost:8000/...).
# NAO inclua o IP do droplet: o site deve ser acedido apenas pelo dominio (o
# nginx ja fecha o acesso por IP, isto e defesa em profundidade).
ALLOWED_HOSTS=placarcerto.digital,www.placarcerto.digital,localhost,127.0.0.1

# Opcional. Se vazio, e derivado automaticamente de ALLOWED_HOSTS
# (https:// e http:// para cada host). So precisa preencher se usar SSL
# terminado noutro sitio ou um dominio diferente do ALLOWED_HOSTS.
# CSRF_TRUSTED_ORIGINS=https://placarcerto.digital,https://www.placarcerto.digital

# ------------------------------------------------------------------------------
# Base de dados (tem de coincidir com o servico `db` do docker-compose.yml)
# ------------------------------------------------------------------------------
DB_NAME=betinsight_db
DB_USER=postgres
DB_PASSWORD=TROCAR-POR-SENHA-FORTE
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------------------------
# Redis / Celery
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# APIs de dados de futebol
# ------------------------------------------------------------------------------
FOOTBALL_DATA_API_KEY=TROCAR
FOOTBALL_DATA_URL=https://api.football-data.org/v4

API_FOOTBALL_KEY=TROCAR
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_URL=https://v3.football.api-sports.io

GOOGLE_GEMINI_API_KEY=TROCAR

# Tem um valor por omissao no settings.py; so preencha para usar outra chave.
# OPENWEATHER_API_KEY=

# ------------------------------------------------------------------------------
# VPay Moçambique (gateway de pagamentos via checkout hospedado)
# Usado por apps/subscriptions/vpay_service.py e vpay_views.py
# Documentação: https://vpay.co.mz/docs
# ------------------------------------------------------------------------------
# IMPORTANTE: VPAY_CLIENT_SECRET e VPAY_WEBHOOK_SECRET são segredos. Configure-os
# apenas aqui (backend/.env.production, fora do Git) ou no gestor de segredos do
# servidor. NUNCA os coloque no código, logs ou controlo de versão.
VPAY_ENABLED=True
VPAY_BASE_URL=https://api.vpay.co.mz
VPAY_CLIENT_ID=app_e7fd19f9678ce3f793eb2d9efaa46f84
VPAY_CLIENT_SECRET=TROCAR-POR-SEGREDO-VPAY
VPAY_APPLICATION_ID=3dd54636-bf2e-413f-b137-3f1d0e555365
VPAY_CHECKOUT_BASE_URL=https://checkout.vpay.co.mz
VPAY_WEBHOOK_SECRET=TROCAR-POR-SEGREDO-WEBHOOK
VPAY_TIMEOUT=30

# ------------------------------------------------------------------------------
# Email transacional (notificacoes de assinatura)
# Por omissao: console backend (as mensagens vao para os logs do container).
# Para enviar de verdade, descomente e preencha o bloco SMTP.
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=PlacarCerto <noreply@placarcerto.digital>

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha-de-app

# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (notificacoes push) - opcional
# ------------------------------------------------------------------------------
FCM_SERVER_KEY=

# ------------------------------------------------------------------------------
# Limites de analise por plano
# ------------------------------------------------------------------------------
FREE_ANALYSIS_LIMIT=3
PREMIUM_ANALYSIS_LIMIT=100
