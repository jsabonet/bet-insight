# VPay Moçambique (gateway de pagamentos via checkout hospedado)
# Documentação: https://vpay.co.mz/docs
# IMPORTANTE: VPAY_CLIENT_SECRET e VPAY_WEBHOOK_SECRET são segredos e NUNCA
# devem estar no código/controlo de versão. Configurar apenas via variável de
# ambiente (backend/.env local, fora do Git).
VPAY_ENABLED=True
VPAY_BASE_URL=https://api.vpay.co.mz
VPAY_CLIENT_ID=app_e7fd19f9678ce3f793eb2d9efaa46f84
VPAY_CLIENT_SECRET=configurar-localmente-fora-do-codigo
VPAY_APPLICATION_ID=3dd54636-bf2e-413f-b137-3f1d0e555365
VPAY_CHECKOUT_BASE_URL=https://checkout.vpay.co.mz
VPAY_WEBHOOK_SECRET=configurar-localmente-fora-do-codigo
VPAY_TIMEOUT=30

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Email Configuration (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-app
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@placarcerto.co.mz

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
