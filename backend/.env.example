# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Pausa temporária de novas seleções de valor; bilhetes múltiplos continuam ativos.
DAILY_BETS_VALUE_ENABLED=False
# Comma-separated trusted proxy IPs/CIDRs. Set only your reverse proxy/CDN ranges;
# forwarded client IP headers are ignored when the direct peer is not trusted.
TRUSTED_PROXY_IPS=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bet_insight

# Football API
FOOTBALL_API_KEY=your-football-api-key-here

# VPay Moçambique (gateway de pagamentos via checkout hospedado)
# Documentação: https://vpay.co.mz/docs
# IMPORTANTE: VPAY_CLIENT_SECRET e VPAY_WEBHOOK_SECRET são segredos e NUNCA
# devem estar no código/controlo de versão. Configurar apenas via variável de
# ambiente (backend/.env local, fora do Git).
VPAY_ENABLED=True
VPAY_BASE_URL=https://api.vpay.co.mz
VPAY_CLIENT_ID=app_e7fd19f9678ce3f793eb2d9efaa46f84
VPAY_CLIENT_SECRET=configurar-localmente-fora-do-codigo
VPAY_APPLICATION_ID=3dd54636-bf2e-413f-b137-3f1d0e555365
VPAY_CHECKOUT_BASE_URL=https://checkout.vpay.co.mz
VPAY_WEBHOOK_SECRET=configurar-localmente-fora-do-codigo
VPAY_TIMEOUT=30

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Email transacional (Resend - https://resend.com)
# 1. Criar conta e verificar o domínio de envio (SPF/DKIM)
# 2. Criar uma API key e colar aqui (NUNCA no controlo de versão)
# Quando RESEND_API_KEY está definida, o backend usa automaticamente a Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=PlacarCerto <noreply@placarcerto.digital>
RESEND_TIMEOUT=20
SUPPORT_EMAIL=suporte@placarcerto.digital
FRONTEND_URL=https://placarcerto.digital

# (Opcional) SMTP legado — ignorado quando RESEND_API_KEY está definida.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PlacarCerto <noreply@placarcerto.digital>

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Programa de Afiliados
# Taxas em decimal (0.40 = 40%).
AFFILIATE_DEFAULT_RATE=0.40
AFFILIATE_VIP_RATE=0.50
AFFILIATE_RENEWAL_RATE=0.10
# Janela (dias) do cookie de afiliado.
AFFILIATE_COOKIE_DAYS=30
# Dias até uma comissão pending ficar available (chargeback/refund).
AFFILIATE_PENDING_DAYS=14
# Valor mínimo (MZN) para levantamento.
AFFILIATE_MIN_WITHDRAWAL=200
# Comissão fixa por venda concluída (MZN).
AFFILIATE_FIXED_COMMISSION=100
# Taxa retida pela plataforma em cada levantamento (%).
AFFILIATE_WITHDRAWAL_FEE_RATE=6
# Planos que NÃO geram comissão (separados por vírgula).
AFFILIATE_EXCLUDED_PLANS=teste,premium_vitalicio_teste
