# ==============================================
# CONFIGURACAO DE PRODUCAO - FRONTEND
# ==============================================
# Copie para frontend/.env.production (nao e commitado).
#
#   cp frontend/.env.production.example frontend/.env.production
#
# IMPORTANTE: este ficheiro e lido no BUILD (npm run build / Vite) e por isso
# e assado no bundle. Alterar aqui obriga a reconstruir a imagem.
# Para mudar o URL da API sem rebuild, use VITE_API_URL no .env da raiz
# (lido em runtime por /config.js) e faca `docker compose up -d frontend`.

# URL da API.
#   /api                  -> relativo: o nginx faz proxy de /api/ para o
#                            backend. Funciona em qualquer dominio/IP e sem
#                            CORS. E o recomendado.
#   https://api.dominio.com -> apenas se a API estiver noutro host (nesse caso
#                            tem de adicionar esse host a ALLOWED_HOSTS e a
#                            CORS_ALLOWED_ORIGINS no backend).
VITE_API_URL=/api

VITE_APP_ENV=production
